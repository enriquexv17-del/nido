{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nido",
  "version": "../package.json",
  "identifier": "com.nido.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nido",
        "width": 1100,
        "height": 760,
        "minWidth": 400,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.github.com https://github.com https://objects.githubusercontent.com https://*.githubusercontent.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "publisher": "Nido",
    "copyright": "Nido",
    "shortDescription": "Sueldos y gastos del hogar, repartidos justo.",
    "longDescription": "Nido reparte los gastos del hogar de forma justa entre sus integrantes. Funciona sin conexión y se sincroniza entre iPhone, Android y PC.",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/enriquexv17-del/nido/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGRTAzMDE1NDVCOTM4QkUKUldTK09MbEZGVERncnhBenIzb1NQRGhOaStQdndWaTI0a3J0dVN3OGZER0VyU3E4aFJ2c1l3dU4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
